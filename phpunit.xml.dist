<?xml version="1.0" encoding="UTF-8"?>
<phpunit
	bootstrap="tests/bootstrap.php"
	colors="true"
	backupGlobals="false"
	beStrictAboutTestsThatDoNotTestAnything="true"
>
	<testsuites>
		<testsuite name="Thumbnail Manager">
			<directory suffix=".php">tests/phpunit</directory>
		</testsuite>
	</testsuites>
</phpunit>
