<?xml version="1.0"?>
<ruleset name="Thumbnail Manager">
	<description>Repository-wide WordPress and PHP compatibility standards for production code and tests.</description>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="extensions" value="php"/>
	<config name="testVersion" value="7.4-"/>
	<config name="ignore_warnings_on_exit" value="1"/>

	<file>thumbnail-manager.php</file>
	<file>uninstall.php</file>
	<file>inc</file>
	<file>tests</file>

	<exclude-pattern>tests/bootstrap.php</exclude-pattern>
	<exclude-pattern>tests/prune-safety-smoke.php</exclude-pattern>

	<rule ref="WordPress"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>thumbnail-manager.php</exclude-pattern>
	</rule>

	<rule ref="Squiz.Commenting">
		<exclude-pattern>tests/phpunit/*</exclude-pattern>
	</rule>

	<rule ref="Generic.Commenting">
		<exclude-pattern>tests/phpunit/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<!-- Persistent job tables are authoritative state and deliberately bypass the object cache. -->
		<exclude-pattern>inc/job-storage.php</exclude-pattern>
		<!-- Lifecycle tests create/drop isolated exact fixtures and assert uncached physical state. -->
		<exclude-pattern>tests/phpunit/test-data-lifecycle.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
		<!-- Job-table names are generated internally; all row values still use placeholders. -->
		<exclude-pattern>inc/job-storage.php</exclude-pattern>
		<!-- Integration fixtures interpolate only trusted table names created by the test harness. -->
		<exclude-pattern>tests/phpunit/test-job-storage-installation.php</exclude-pattern>
		<exclude-pattern>tests/phpunit/test-job-storage.php</exclude-pattern>
		<exclude-pattern>tests/phpunit/test-media-source-index.php</exclude-pattern>
		<exclude-pattern>tests/phpunit/test-data-lifecycle.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.DB.PreparedSQLPlaceholders.ReplacementsWrongNumber">
		<exclude-pattern>inc/job-storage.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.PHP.NoSilencedErrors.Discouraged">
		<exclude-pattern>tests/phpunit/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>tests/phpunit/*</exclude-pattern>
		<exclude-pattern>tests/job-storage-smoke.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="thumbnail-manager"/>
			</property>
		</properties>
	</rule>
</ruleset>
